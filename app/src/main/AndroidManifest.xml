<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==========================================================
         MUHIM: READ_CALL_LOG / READ_SMS / RECEIVE_SMS ruxsatlarini
         Google Play faqat ilova qurilmaning STANDART Phone yoki SMS
         ilovasi (default handler) sifatida tanlanganda beradi.
         Bu ruxsatlarni oddiy "yordamchi ilova" sifatida deklaratsiya
         qilib bo'lmaydi — Play Console tekshiruvidan o'tmaydi.
         Ilova o'rnatilgach, foydalanuvchi buni albatta:
         Sozlamalar > Ilovalar > Standart ilovalar > Telefon/SMS
         bo'limidan QO'LDA tanlashi kerak.
         ========================================================== -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.OilaNazorati"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ChildSetupActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ParentDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TrendsActivity"
            android:exported="false" />

        <!-- Kun/oy bo'yicha joylashuv tarixini Google Xaritada ko'rsatadigan ekran -->
        <activity
            android:name=".ui.LocationHistoryActivity"
            android:exported="false" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <!-- Chiquvchi SMS yozish ekrani. Ilova standart SMS ilovasi (ROLE_SMS)
             bo'lishi uchun tizim ACTION_SENDTO/ACTION_SEND'ni ushlaydigan
             activity talab qiladi. Bu ekran orqali yuborilgan SMS'ning
             qabul qiluvchi raqami shu ekranda ma'lum bo'lgani uchun, uni
             jo'natishdan OLDIN anonim xash'ga aylantirib, SmsSentReceiver'ga
             uzatamiz — raqamning o'zi hech qayerga saqlanmaydi. -->
        <activity
            android:name=".ui.ComposeSmsActivity"
            android:exported="true"
            android:label="SMS yozish">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Saqlangan kontaktlarni (faqat ism + rang, raqamsiz) ota-onaga
             ko'rsatadigan ekran -->
        <activity
            android:name=".ui.SavedContactsActivity"
            android:exported="false" />

        <!-- Qo'ng'iroqlarni skrinlash — standart Phone ilovasi bo'lgandagina ishlaydi -->
        <service
            android:name=".service.CallMonitorService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- SMS qabul qilish — standart SMS ilovasi bo'lgandagina to'liq ishlaydi -->
        <receiver
            android:name=".service.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Chiquvchi SMS'ni kuzatish uchun (yuborilgan xabar sonini +1 qilish) -->
        <receiver
            android:name=".service.SmsSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="uz.oilanazorati.SMS_SENT" />
            </intent-filter>
        </receiver>

        <!-- Fon xizmati: ilova ishlatilish vaqtini va lokatsiyani davriy yig'adi -->
        <service
            android:name=".service.MonitorForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Qurilma qayta yoqilganda fon xizmatini avtomatik ishga tushirish -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
