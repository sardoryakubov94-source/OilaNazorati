<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Shu kontaktga tegishli barqaror rang — ism bo'lmasa ham,
         "bugun shu odam bilan necha marta gaplashilgani" shu rang
         orqali bir qarashda ko'rinadi. -->
    <View
        android:id="@+id/contactColorDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/shape_color_dot"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/smsContactLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="14sp"
            android:text="Saqlanmagan kontakt"/>

        <TextView
            android:id="@+id/smsDetailLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#666666"
            android:text="Qabul qilingan"/>

    </LinearLayout>

    <TextView
        android:id="@+id/smsTimeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:layout_marginStart="8dp"
        android:text="00:00"/>

</LinearLayout>
