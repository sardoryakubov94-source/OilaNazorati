<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1B2D">

    <LinearLayout
        android:id="@+id/loginSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="56sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Davom etish uchun ota-onaning Google hisobi bilan kiring"
            android:textColor="#AEB8C4"
            android:textAlignment="center"
            android:layout_marginBottom="40dp"/>

        <Button
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="G   Google bilan kirish"
            android:textAllCaps="false"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#FFFFFF"/>

        <TextView
            android:id="@+id/loginStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AEB8C4"
            android:textAlignment="center"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/roleSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ Oila Nazorati"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/signedInAsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AEB8C4"
            android:textAlignment="center"
            android:layout_marginBottom="40dp"/>

        <Button
            android:id="@+id/btnOpenParentDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ota-ona panelini ochish"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/btnSignOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chiqish (boshqa hisobga o'tish)"
            android:textColor="#AEB8C4"
            android:padding="12dp"/>

    </LinearLayout>

    <!-- MUHIM: bu tugma ATAYLAB har ikkala bo'limdan (login/role)
         TASHQARIDA joylashtirilgan va HAR DOIM ko'rinadi — Google
         orqali kirilgan-kirilmaganidan qat'i nazar. Sabab: bola
         qurilmasini sozlash uchun Google hisobi UMUMAN kerak emas —
         ChildSetupActivity o'zining PIN himoyasi bilan mustaqil
         ishlaydi va ma'lumot yozish uchun anonim (Google'ga bog'liq
         bo'lmagan) identifikator ishlatadi. Google talabi faqat Ota-ona
         panelini ochish uchun qoladi, chunki u yerda haqiqiy shaxsni
         tasdiqlash muhim. -->
    <Button
        android:id="@+id/btnChildDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="32dp"
        android:text="Bu farzandimning telefoni (Google shart emas)"
        android:backgroundTint="#3A4B63"
        android:textColor="#FFFFFF"/>

</FrameLayout>
