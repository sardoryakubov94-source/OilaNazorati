<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ Oila Nazorati"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shaffof va oshkora nazorat — farzandingiz biladi va rozi."
        android:textAlignment="center"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnChildDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bu farzandimning telefoni"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnParentDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Men ota-onaman, nazorat qilaman"/>

</LinearLayout>
