<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- ========== 1-BOSQICH: umumiy kirish paroli ==========
         Bank ilovalaridagi kabi — ilova HAR safar ochilganda shu
         ekran birinchi ko'rinadi, hech qanday Google talab qilinmaydi.
         Bola telefonida FAQAT shu bitta parol turadi. -->
    <ScrollView
        android:id="@+id/passwordSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_app_logo"
            android:layout_marginBottom="16dp"
            android:contentDescription="Oila nazorati logotipi"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oila Nazorati"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Farzandingiz xavfsizligi — bir joyda"
            android:textColor="#B9A97A"
            android:textSize="13sp"
            android:layout_marginBottom="28dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_login_card"
            android:padding="24dp">

            <TextView
                android:id="@+id/passwordPromptText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Davom etish uchun parolni kiriting"
                android:textColor="#D8CBA0"
                android:textAlignment="center"
                android:textSize="13sp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAROL"
                android:textColor="#B9A97A"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/inputAppPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:inputType="numberPassword"
                android:hint="••••"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_input_outline"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B5A2E"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnPasswordSubmit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Kirish"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1B1305"
                android:background="@drawable/bg_button_gold"
                android:elevation="0dp"
                android:stateListAnimator="@null"/>

            <TextView
                android:id="@+id/passwordStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E57373"
                android:textAlignment="center"
                android:textSize="12sp"
                android:layout_marginTop="14dp"/>
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- ========== 2-BOSQICH: rol tanlash ==========
         Parol to'g'ri kiritilgandan keyin ko'rinadi. Bu yerda hali
         ham Google talab qilinmaydi. -->
    <LinearLayout
        android:id="@+id/roleSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_app_logo"
            android:layout_marginBottom="16dp"
            android:contentDescription="Oila nazorati logotipi"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oila Nazorati"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="36dp"/>

        <Button
            android:id="@+id/btnChildDevice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Bu farzandimning telefoni"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#1B1305"
            android:background="@drawable/bg_button_gold"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnOpenParentDashboard"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ota-ona panelini ochish"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#F5C542"
            android:background="@drawable/bg_login_card"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnSupport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✍️ Yordam (Bizga yozing)"
            android:textAllCaps="false"
            android:textColor="#B9A97A"
            android:background="@drawable/bg_login_card"
            android:layout_marginBottom="14dp"/>

    </LinearLayout>

    <!-- ========== 3-BOSQICH: faqat Ota-ona paneli uchun Google ==========
         "Ota-ona panelini ochish" bosilganda, agar hali Google orqali
         kirilmagan bo'lsa, shu ekran ko'rinadi. -->
    <LinearLayout
        android:id="@+id/loginSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_app_logo"
            android:layout_marginBottom="20dp"
            android:contentDescription="Oila nazorati logotipi"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ota-ona paneli"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google hisobi bilan kiring"
            android:textColor="#B9A97A"
            android:textAlignment="center"
            android:textSize="13sp"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_login_card"
            android:padding="20dp">

            <Button
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="G   Google bilan kirish"
                android:textAllCaps="false"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary_white"/>

            <TextView
                android:id="@+id/loginStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B9A97A"
                android:textAlignment="center"
                android:textSize="12sp"
                android:layout_marginTop="18dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnBackFromLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Orqaga"
            android:textColor="#B9A97A"
            android:padding="16dp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</FrameLayout>
