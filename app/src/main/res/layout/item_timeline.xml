<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <!-- Kontaktning anonim rangi: raqam ko'rinmaydi, lekin "shu odammi
         yoki boshqasimi" shu rang orqali bir qarashda bilinadi. -->
    <View
        android:id="@+id/contactColorDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/shape_color_dot"/>

    <ImageView
        android:id="@+id/callDirectionIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Qo'ng'iroq yo'nalishi"/>

    <TextView
        android:id="@+id/timelineLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14sp"/>

</LinearLayout>
