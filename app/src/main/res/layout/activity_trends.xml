<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_badge_purple">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chart"
                android:tint="#FFFFFF"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Umumiy ma'lumotlar"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/trendsStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Umumiy statistika (bugun)"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="10dp"/>

    <!-- Bugungi statistika: barcha 4 karta aynan bir xil o'lchamda. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_theme"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="Qo'ng'iroqlar"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/donutCalls"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/legendCalls"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="top|start"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="7"
                android:ellipsize="end"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:layout_weight="1"
            android:layout_marginEnd="0dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_theme"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="SMS"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/donutSms"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/legendSms"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="top|start"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="7"
                android:ellipsize="end"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_theme"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="Kontaktlar"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/donutContacts"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/legendContacts"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="top|start"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="7"
                android:ellipsize="end"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:layout_weight="1"
            android:layout_marginEnd="0dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_theme"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="Ilovalar"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/donutApps"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/legendApps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="top|start"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="7"
                android:ellipsize="end"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Qachon eng ko'p gaplashadi (soat bo'yicha, 7 kunlik)"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/hourlyCallChart"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Qachon eng ko'p SMS yozishadi (soat bo'yicha, 7 kunlik)"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/hourlySmsChart"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Eng ko'p mashg'ul bo'lgan ilovalar (7 kunlik jami)"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/topAppsChart"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kunlik: necha xil kontakt bilan gaplashgan (30 kunlik)"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/dailyContactCountChart"
        android:layout_width="match_parent"
        android:layout_height="220dp"/>

    <TextView
        android:id="@+id/dailyContactCountDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuqtani bosing — o'sha kuni kim bilan bo'lganini ko'rish uchun"
        android:textSize="11sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kunlik: jami necha daqiqa gaplashgan (30 kunlik)"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/dailyCallMinutesChart"
        android:layout_width="match_parent"
        android:layout_height="220dp"/>

    <TextView
        android:id="@+id/dailyCallMinutesDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuqtani bosing — o'sha kuni kim bilan bo'lganini ko'rish uchun"
        android:textSize="11sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="30 kun ichida eng ko'p gaplashgan kontaktlar"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/topContactSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/topContactsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kunlik: necha xil kontakt bilan SMS yozishgan (30 kunlik)"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/dailySmsContactCountChart"
        android:layout_width="match_parent"
        android:layout_height="220dp"/>

    <TextView
        android:id="@+id/dailySmsContactCountDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuqtani bosing — o'sha kuni kim bilan SMS bo'lganini ko'rish uchun"
        android:textSize="11sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kunlik: jami necha SMS yozilgan (30 kunlik)"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/dailySmsCountChart"
        android:layout_width="match_parent"
        android:layout_height="220dp"/>

    <TextView
        android:id="@+id/dailySmsCountDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuqtani bosing — o'sha kuni kim bilan SMS bo'lganini ko'rish uchun"
        android:textSize="11sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="30 kun ichida eng ko'p SMS yozishilgan kontaktlar"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/topSmsContactSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/topSmsContactsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
</ScrollView>

    <include layout="@layout/layout_bottom_nav"/>

</LinearLayout>
