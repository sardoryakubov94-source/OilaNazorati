<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/appColorDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/shape_color_dot"/>

        <TextView
            android:id="@+id/appName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/appDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:textSize="13sp"/>

    </LinearLayout>

    <!-- Progress yoli: bg_progress_track ustida foiz bo'yicha
         kengaytiriladigan rangli segment (weight orqali) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_progress_track"
        android:orientation="horizontal">

        <View
            android:id="@+id/appProgressFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="@drawable/bg_progress_fill"/>

        <View
            android:id="@+id/appProgressSpacer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="100"/>

    </LinearLayout>

</LinearLayout>
