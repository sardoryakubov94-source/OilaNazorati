<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bu ro'yxat faqat bola qurilmasida ISM BILAN saqlangan kontaktlarni ko'rsatadi (masalan oila a'zolari). Saqlanmagan raqamlar bu yerga tushmaydi va boshqa joyda ham faqat rang bilan, ismsiz/raqamsiz ko'rinadi."
        android:textSize="13sp"
        android:layout_marginBottom="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/savedContactsList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>
