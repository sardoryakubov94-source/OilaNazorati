<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- Asosiy kontent -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ========== HEADER ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#161B22">

            <!-- Logo -->
            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="🛡️"
                android:textSize="22sp"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oila nazorati"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/headerFamilyCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="------"
                        android:textColor="#8B96A5"
                        android:textSize="12sp"
                        android:background="@drawable/bg_card"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/headerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● FAOL"
                        android:textColor="#2ECC71"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                </LinearLayout>
            </LinearLayout>

            <!-- Settings (Yangi kod / Farzand tanlash) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnChooseChild"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_card_clickable"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        android:tint="#FFFFFF"
                        android:contentDescription="Farzand tanlash"/>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_card_clickable"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_settings"
                        android:tint="#FFFFFF"
                        android:contentDescription="Sozlamalar"/>
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ========== JOYLASHUV KARTASI ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#161B22"
            android:padding="16dp"
            android:layout_marginTop="1dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 SO'NGGI JOYLASHUV"
                    android:textColor="#2ECC71"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/locationTimeAgo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕐  --:-- • --- daqiqa oldin"
                    android:textColor="#8B96A5"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/locationCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---, ---"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/locationCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#8B96A5"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/btnLocationHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xaritada ko'rish →"
                    android:textColor="#2ECC71"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/bg_card"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"/>

            </LinearLayout>

            <!-- Mini xarita placeholder -->
            <FrameLayout
                android:id="@+id/miniMapContainer"
                android:layout_width="120dp"
                android:layout_height="100dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_card"/>

        </LinearLayout>

        <!-- ========== BUGUNGI NAZORAT stats ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BUGUNGI NAZORAT"
            android:textColor="#2ECC71"
            android:textStyle="bold"
            android:textSize="11sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <!-- Qo'ng'iroqlar -->
            <LinearLayout
                android:id="@+id/cardStatCalls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:minHeight="140dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_green">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_call"
                        android:tint="#FFFFFF"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/statCallCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 ta"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Qo'ng'iroqlar"
                    android:textColor="#8B96A5"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="9sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/statCallDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0 kiruvchi\n0 chiquvchi"
                    android:textColor="#2ECC71"
                    android:textSize="8sp"
                    android:minLines="2"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

            <!-- SMS -->
            <LinearLayout
                android:id="@+id/cardStatSms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:minHeight="140dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_blue">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_message"
                        android:tint="#FFFFFF"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/statSmsCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 ta"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="SMS"
                    android:textColor="#8B96A5"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="9sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/statSmsDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0 yuborilgan\n0 qabul"
                    android:textColor="#3498DB"
                    android:textSize="8sp"
                    android:minLines="2"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

            <!-- Kontaktlar -->
            <LinearLayout
                android:id="@+id/cardStatContacts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:minHeight="140dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_purple">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_group"
                        android:tint="#FFFFFF"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/statContactCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 ta"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kontaktlar"
                    android:textColor="#8B96A5"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="9sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Bugun\nfaol"
                    android:textColor="#9B59B6"
                    android:textSize="8sp"
                    android:minLines="2"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

            <!-- Ilovalar -->
            <LinearLayout
                android:id="@+id/cardStatApps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:minHeight="140dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_orange">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_apps"
                        android:tint="#FFFFFF"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/statAppCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 ta"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ilovalar"
                    android:textColor="#8B96A5"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="9sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Faoliyat\nkuzatilmoqda"
                    android:textColor="#F39C12"
                    android:textSize="8sp"
                    android:minLines="2"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ========== QO'NG'IROQLAR bo'limi ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161B22"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📞 QO'NG'IROQLAR"
                    android:textColor="#2ECC71"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/btnCallHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barchasini ko'rish →"
                    android:textColor="#2ECC71"
                    android:textSize="12sp"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/timelineList"
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:nestedScrollingEnabled="true"
                android:clipToPadding="false"/>

        </LinearLayout>

        <!-- ========== SMS bo'limi ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161B22"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💬 SMS"
                    android:textColor="#3498DB"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/btnSmsHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barchasini ko'rish →"
                    android:textColor="#3498DB"
                    android:textSize="12sp"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/smsTimelineList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/smsSectionEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bugun SMS yo'q"
                android:textColor="#8B96A5"
                android:textSize="13sp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- ========== MULOQOTLAR bo'limi ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161B22"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👥 MULOQOTLAR"
                    android:textColor="#9B59B6"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/btnSavedContacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barchasini ko'rish →"
                    android:textColor="#9B59B6"
                    android:textSize="12sp"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contactSummaryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- ========== ILOVALAR bo'limi ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161B22"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📱 ILOVALAR"
                    android:textColor="#F39C12"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/btnTrends"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barchasini ko'rish →"
                    android:textColor="#F39C12"
                    android:textSize="12sp"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appUsageList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- ========== PASTKI NAVIGATSIYA ========== -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
