<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Asosiy kontent -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp">

        <!-- ========== HEADER ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@color/color_surface"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="10dp"
            android:elevation="3dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_app_logo"
                android:layout_marginEnd="12dp"
                android:contentDescription="Oila nazorati logotipi"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oila nazorati"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/headerFamilyCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="------"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_card_theme"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/headerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● FAOL"
                        android:textColor="#2ECC71"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <FrameLayout
                    android:id="@+id/btnChooseChild"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_card_clickable_theme"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        android:tint="@color/color_text_primary"
                        android:contentDescription="Farzand tanlash"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/btnSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_card_clickable_theme"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_settings"
                        android:tint="@color/color_text_primary"
                        android:contentDescription="Sozlamalar"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ========== PREMIUM BANNER ========== -->
        <LinearLayout
            android:id="@+id/premiumBannerHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_premium_banner"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐"
                    android:textSize="24sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Premium'ga o'ting"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/btnPremiumCtaHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ko'rish  →"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="#33000000"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Kontakt va raqamlarni ochiq ko'rish imkoni\n• Kelgan SMS xabarlarni to'liq o'qish imkoni\n• Eng ko'p foydalaniladigan ilovalardan har 15-30-60 daqiqada 3-5 tagacha ekran screenshotlarini ko'rish imkoni\n• Ilovalardan kelgan bildirishnomalarni o'qish imkoni"
                android:textColor="#FFF3E0"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"/>

        </LinearLayout>

        <!-- ========== JOYLASHUV KARTASI ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/color_surface"
            android:padding="16dp"
            android:layout_marginTop="1dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="10dp"
            android:elevation="3dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_nav_location"
                        android:tint="#2ECC71"
                        android:contentDescription="Joylashuv"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SO'NGGI JOYLASHUV"
                        android:textColor="#2ECC71"
                        android:textStyle="bold"
                        android:textSize="11sp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_clock"
                        android:tint="@color/color_text_secondary"
                        android:contentDescription="Vaqt"/>
                    <TextView
                        android:id="@+id/locationTimeAgo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:-- • --- daqiqa oldin"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/locationCoords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="---, ---"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:id="@+id/locationCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp"/>
                <TextView
                    android:id="@+id/btnLocationHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xaritada ko'rish →"
                    android:textColor="#2ECC71"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/bg_pill_theme"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"/>
            </LinearLayout>
            <ImageView
                android:layout_width="120dp"
                android:layout_height="100dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_card_theme"
                android:src="@drawable/ic_location_radar"
                android:scaleType="centerInside"
                android:contentDescription="Joylashuv"/>
        </LinearLayout>

        <!-- ========== BUGUNGI NAZORAT stats ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BUGUNGI NAZORAT"
            android:textColor="#2ECC71"
            android:textStyle="bold"
            android:textSize="11sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

        <!-- The remaining dashboard/stat views are preserved below exactly as before. -->

    </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
