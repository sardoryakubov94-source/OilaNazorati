<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/msgEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/color_success_text"
        android:textStyle="bold"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/msgText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/color_text_primary"
        android:textSize="14sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/msgContactNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/color_text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/msgStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#F39C12"
        android:textSize="11sp"
        android:layout_marginTop="6dp"/>

    <Button
        android:id="@+id/btnReply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Javob yozish"
        android:textSize="12sp"
        android:layout_marginTop="8dp"/>

    <!-- Faqat EGASI (asosiy admin) uchun ko'rinadi — shu foydalanuvchining
         yozishmasini (yuborgani ham, javobi ham) boshqa adminlardan
         yashiradi/qayta ko'rsatadi. -->
    <Button
        android:id="@+id/btnToggleHideSender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Boshqa adminlardan yashirish"
        android:textSize="12sp"
        android:background="@drawable/bg_card_clickable"
        android:layout_marginTop="6dp"
        android:visibility="gone"/>

</LinearLayout>
