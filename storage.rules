rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner(code) {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        firestore.get(/databases/(default)/documents/families/$(code)).data.ownerUid == request.auth.uid;
    }
    function childOwns(code, childId) { return signedIn() && request.auth.uid == childId; }

    match /families/{familyCode}/children/{childId}/screenshots/{allPaths=**} {
      allow read: if owner(familyCode);
      allow write: if childOwns(familyCode, childId);
    }
  }
}
