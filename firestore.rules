rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // ADMIN
    // =========================

    function isAdmin() {
      // MUHIM (xavfsizlik/maxfiylik): ilgari bu yerda ikkita shaxsiy Gmail
      // manzili ochiq (plain-text) holda yozilgan edi. Bu fayl PUBLIC
      // GitHub repo'da yotgani uchun HAR KIM uni ochib, admin sifatida
      // tan olinadigan aniq email manzillarini ko'ra olardi (bu email
      // egalarini nishonlab fishing/hacking urinishi uchun qulay
      // ma'lumot). Endi email o'rniga UID ro'yxati "admin_uids"
      // kolleksiyasida saqlanadi — bu email manzillarini oshkor qilmaydi.
      //
      // KO'CHIRISH UCHUN QILISH KERAK (Firebase konsolida, qo'lda):
      //  1) Firestore'da "admin_uids" nomli yangi kolleksiya oching.
      //  2) Har bir admin uchun bitta hujjat qo'shing — hujjat ID'si
      //     o'sha odamning Firebase Auth UID'i bo'lishi kerak (buni
      //     Firebase Console -> Authentication -> Users bo'limidan,
      //     tegishli email qatoridagi "User UID" ustunidan olasiz).
      //     Hujjat matni bo'sh {} bo'lsa ham yetarli.
      //  3) Shu faylni Firebase Console -> Firestore -> Rules bo'limiga
      //     joylab, "Publish" bosing (bu commit avtomatik deploy
      //     qilinmaydi — men bu yerdan Firebase loyihasiga ulana
      //     olmayman, faqat kodni tayyorlab qo'ydim).
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        exists(/databases/$(database)/documents/admin_uids/$(request.auth.uid));
    }

    // =========================
    // REAL USER
    // =========================

    function isRealUser() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // =========================
    // APP CONFIG (versiya tekshiruvi)
    // =========================
    // Hech qanday tizimga kirilmagan holatda ham (ilova ilk marta
    // ochilganda, hali anonim sessiya ham yaratilmagan bo'lishi mumkin)
    // o'qilishi kerak — shuning uchun ochiq. Sezgir ma'lumot emas
    // (faqat eng kam qo'llab-quvvatlanadigan versiya raqami).
    match /app_config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // =========================
    // ADMIN_UIDS (kim admin ekanini bilish uchun)
    // =========================
    // MUHIM: bu bloksiz ilova o'zining admin ekanini TEKSHIRA OLMAYDI —
    // isAdmin() ichidagi exists() faqat QOIDALARNI baholashda ishlaydi,
    // lekin ilova client tarafdan bevosita admin_uids/{uid}ni o'qimoqchi
    // bo'lganda, bu yo'l uchun alohida ruxsat yozilmasa, Firestore uni
    // RAD ETADI. Har bir odam FAQAT o'zining UID'iga mos hujjatni o'qiy
    // oladi (boshqa adminlar ro'yxatini ko'ra olmaydi), yoza olmaydi.
    match /admin_uids/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // =========================
    // FAMILIES

    // =========================

    match /families/{familyCode} {

      function isRealOwner() {
        return isRealUser() &&
          exists(
            /databases/$(database)/documents/families/$(familyCode)
          ) &&
          get(
            /databases/$(database)/documents/families/$(familyCode)
          ).data.ownerUid == request.auth.uid;
      }

      allow create: if isRealUser() &&
        request.resource.data.ownerUid == request.auth.uid;

      allow get, update, delete: if isRealOwner();

      allow list: if isRealUser() && resource.data.ownerUid == request.auth.uid;

      match /children/{childId} {

        function isThisChildsOwnSession() {
          return request.auth != null &&
            request.auth.uid == childId;
        }

        // Bola (anonim foydalanuvchi) families/{familyCode} hujjatini
        // to'g'ridan-to'g'ri o'qiy olmaydi (buni faqat isRealOwner()
        // qila oladi). Shu sabab bola birinchi marta ulanayotganda
        // (create) oila kodi HAQIQATAN mavjudligini shu yerda,
        // exists() orqali tekshiramiz — bu ma'lumotni oshkor qilmaydi,
        // faqat ruxsat/rad natijasini beradi.
        function familyDocExists() {
          return exists(/databases/$(database)/documents/families/$(familyCode));
        }

        allow read:
          if isRealOwner() || isThisChildsOwnSession();
        allow write:
          if isRealOwner() || (isThisChildsOwnSession() && familyDocExists());

        match /screenshot_settings/{docId} {
          allow read:
            if isRealOwner() || isThisChildsOwnSession();
          allow create, update:
            if isRealOwner() && docId == 'current';
          allow delete:
            if isRealOwner();
        }

        match /screenshot_trigger_state/{docId} {
          allow read:
            if isRealOwner() || isThisChildsOwnSession();
          allow create, update:
            if isThisChildsOwnSession();
          allow delete:
            if isRealOwner();
        }

        match /screenshot_requests/{docId} {
          allow read:
            if isRealOwner() || isThisChildsOwnSession();
          allow create:
            if isRealOwner() &&
              docId == 'current' &&
              request.resource.data.status == 'requested' &&
              request.resource.data.requestedByUid == request.auth.uid;
          allow update:
            if (
              isRealOwner() &&
              docId == 'current'
            ) ||
            (
              isThisChildsOwnSession() &&
              docId == 'current' &&
              request.resource.data.requestId == resource.data.requestId
            );
          allow delete:
            if isRealOwner();
        }

        match /screenshots/{docId} {
          allow read:
            if isRealOwner();
          allow create:
            if isThisChildsOwnSession();
          allow update, delete:
            if isRealOwner();
        }

        match /screenshot_data/{docId} {
          allow read:
            if isRealOwner();
          allow create:
            if isThisChildsOwnSession();
          allow update, delete:
            if isRealOwner();
        }

        match /mic_requests/{docId} {
          allow read:
            if isRealOwner() || isThisChildsOwnSession();
          // Ota-ona tomonidan YANGI ovoz so'rovi boshlanishi (yoki
          // yangilanishi) FAQAT premium bo'lsa ruxsat etiladi — bu
          // ilova UI'sidagi tekshiruvdan tashqari, ma'lumotlar bazasi
          // darajasidagi qo'shimcha himoya. Bola o'z javobini
          // (webrtcAnswer/candidates/status) yozishi premiumga bog'liq
          // emas — sessiya allaqachon ruxsat etilgan bo'lib bo'ladi.
          allow create, update:
            if (
              isRealOwner() &&
              (
                get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.premium == true ||
                isAdmin()
              )
            ) || isThisChildsOwnSession();
          allow delete:
            if isRealOwner();
        }

        match /mic_audio/{docId} {
          allow create:
            if isThisChildsOwnSession();
          allow read:
            if isRealOwner();
          allow delete:
            if isRealOwner();
          allow update:
            if false;
        }

        match /voice_recordings/{docId} {
          allow create:
            if isThisChildsOwnSession();
          allow read:
            if isRealOwner();
          allow delete:
            if isRealOwner();
          allow update:
            if false;
        }

        match /{subcollection}/{docId} {
          allow read, write:
            if (isRealOwner() || isThisChildsOwnSession())
              && subcollection != 'screenshot_settings'
              && subcollection != 'screenshot_trigger_state'
              && subcollection != 'screenshot_requests'
              && subcollection != 'screenshots'
              && subcollection != 'screenshot_data'
              && subcollection != 'mic_requests'
              && subcollection != 'mic_audio'
              && subcollection != 'voice_recordings';
        }
      }
    }

    match /parents/{uid} {
      allow read:
        if isRealUser() &&
        (request.auth.uid == uid || isAdmin());
      allow write:
        if isRealUser() &&
        (request.auth.uid == uid || isAdmin());
    }

    match /support_messages/{msgId} {
      allow create:
        if isRealUser() &&
        request.resource.data.fromUid == request.auth.uid;
      allow read:
        if isRealUser() &&
        (
          resource.data.fromUid == request.auth.uid ||
          isAdmin()
        );
      allow update:
        if isAdmin();
    }

    match /premium_requests/{reqId} {
      allow create:
        if isRealUser() &&
        request.resource.data.fromUid == request.auth.uid;
      allow read:
        if isRealUser() &&
        (
          resource.data.fromUid == request.auth.uid ||
          isAdmin()
        );
      allow update:
        if isAdmin();
    }

    match /admin_cards/{cardId} {
      allow read:
        if isRealUser();
      allow write:
        if isAdmin();
    }
  }
}
