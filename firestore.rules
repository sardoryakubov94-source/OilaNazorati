rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // MUHIM: bu ilovaning yagona administratori — faqat shu email bilan
    // Google orqali kirgan foydalanuvchi admin panelga, kartalar
    // bo'limiga va boshqalarning support/premium so'rovlariga kira oladi.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.auth.token.email == 'sardoryakubov94@gmail.com';
    }

    function isRealUser() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /families/{familyCode} {

      // Oila hujjatining o'zi ("ownerUid" maydonini saqlaydi — kim bu
      // kodni birinchi bo'lib yaratgan bo'lsa, o'sha).
      function isRealOwner() {
        return isRealUser() &&
          exists(/databases/$(database)/documents/families/$(familyCode)) &&
          get(/databases/$(database)/documents/families/$(familyCode)).data.ownerUid == request.auth.uid;
      }

      // Kod birinchi marta yaratilganda: FAQAT haqiqiy (anonim bo'lmagan,
      // ya'ni Google orqali kirgan) foydalanuvchi, va faqat O'ZINING
      // UID'ini ownerUid sifatida yozsa bo'ladi — boshqa birovning
      // UID'ini yoza olmaydi.
      allow create: if isRealUser() && request.resource.data.ownerUid == request.auth.uid;

      // MUHIM: bu qoidaning o'zagi shu yerda — endi shunchaki "kimdir
      // kirganmi" emas, balki "bu ANIQ SHU kodni yaratgan Google
      // hisobimi" tekshiriladi. Kodni bilib qolgan begona Google
      // hisobi (ownerUid mos kelmasa) hech narsani o'qiy olmaydi.
      allow read, update, delete: if isRealOwner();

      match /children/{childId} {
        // Bola qurilmasi ChildSetupActivity'da signInAnonymously()
        // orqali oladigan identifikatori — Google hisobiga BUTUNLAY
        // bog'liq emas (shu tufayli ota-ona Gmail'dan chiqib ketsa ham
        // bola qurilmasining yozish huquqi davom etadi). Bola FAQAT
        // o'zining childId'siga mos hujjatga yoza oladi — boshqa
        // childId'ga emas.
        function isThisChildsOwnSession() {
          return request.auth != null && request.auth.uid == childId;
        }

        allow read, write: if isRealOwner() || isThisChildsOwnSession();

        match /{subcollection}/{docId} {
          allow read, write: if isRealOwner() || isThisChildsOwnSession();
        }
      }
    }

    // ---------------- Ota-ona profillari (Premium bayrog'i shu yerda) ----------------
    match /parents/{uid} {
      // O'zining profilini o'qish/yozish (ism, email va h.k. saqlash uchun),
      // yoki admin — masalan Premium bayrog'ini yoqish uchun.
      allow read: if isRealUser() && (request.auth.uid == uid || isAdmin());
      allow write: if isRealUser() && (request.auth.uid == uid || isAdmin());
    }

    // ---------------- Support (Bizga yozing) xabarlari ----------------
    match /support_messages/{msgId} {
      allow create: if isRealUser() && request.resource.data.fromUid == request.auth.uid;
      // Foydalanuvchi FAQAT o'z xabarlarini, admin esa HAMMASINI o'qiy oladi.
      allow read: if isRealUser() && (resource.data.fromUid == request.auth.uid || isAdmin());
      // Faqat admin javob yozib, holatni yangilay oladi.
      allow update: if isAdmin();
    }

    // ---------------- Premium so'rovlari ----------------
    match /premium_requests/{reqId} {
      allow create: if isRealUser() && request.resource.data.fromUid == request.auth.uid;
      allow read: if isRealUser() && (resource.data.fromUid == request.auth.uid || isAdmin());
      // Faqat admin tasdiqlaydi/rad etadi.
      allow update: if isAdmin();
    }

    // ---------------- Admin to'lov kartalari ----------------
    // Premium so'rov yuborayotgan HAR QANDAY haqiqiy foydalanuvchi
    // kartalarni ko'rishi kerak (to'lov qilish uchun) — lekin faqat
    // admin ularni qo'shishi/o'zgartirishi mumkin.
    match /admin_cards/{cardId} {
      allow read: if isRealUser();
      allow write: if isAdmin();
    }
  }
}
