rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // ADMIN
    // =========================

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.auth.token.email in [
          'sardoryakubov94@gmail.com',
          'marselovgayniddin4@gmail.com'
        ];
    }

    // =========================
    // REAL USER
    // =========================

    function isRealUser() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // =========================
    // FAMILIES
    // =========================

    match /families/{familyCode} {

      function isRealOwner() {
        return isRealUser() &&
          exists(
            /databases/$(database)/documents/families/$(familyCode)
          ) &&
          get(
            /databases/$(database)/documents/families/$(familyCode)
          ).data.ownerUid == request.auth.uid;
      }

      allow create: if isRealUser() &&
        request.resource.data.ownerUid == request.auth.uid;

      allow get, update, delete: if isRealOwner();

      allow list: if isRealUser() && resource.data.ownerUid == request.auth.uid;

      match /children/{childId} {

        function isThisChildsOwnSession() {
          return request.auth != null &&
            request.auth.uid == childId;
        }

        // Bola (anonim foydalanuvchi) families/{familyCode} hujjatini
        // to'g'ridan-to'g'ri o'qiy olmaydi (buni faqat isRealOwner()
        // qila oladi). Shu sabab bola birinchi marta ulanayotganda
        // (create) oila kodi HAQIQATAN mavjudligini shu yerda,
        // exists() orqali tekshiramiz — bu ma'lumotni oshkor qilmaydi,
        // faqat ruxsat/rad natijasini beradi.
        function familyDocExists() {
          return exists(/databases/$(database)/documents/families/$(familyCode));
        }

        allow read:
          if isRealOwner() || isThisChildsOwnSession();
        allow write:
          if isRealOwner() || (isThisChildsOwnSession() && familyDocExists());

        match /screenshot_settings/{docId} {
          allow read:
            if isRealOwner() || isThisChildsOwnSession();
          allow create, update:
            if isRealOwner() && docId == 'current';
          allow delete:
            if isRealOwner();
        }

        match /screenshot_trigger_state/{docId} {
          allow read:
            if isRealOwner() || isThisChildsOwnSession();
          allow create, update:
            if isThisChildsOwnSession();
          allow delete:
            if isRealOwner();
        }

        match /screenshot_requests/{docId} {
          allow read:
            if isRealOwner() || isThisChildsOwnSession();
          allow create:
            if isRealOwner() &&
              docId == 'current' &&
              request.resource.data.status == 'requested' &&
              request.resource.data.requestedByUid == request.auth.uid;
          allow update:
            if (
              isRealOwner() &&
              docId == 'current'
            ) ||
            (
              isThisChildsOwnSession() &&
              docId == 'current' &&
              request.resource.data.requestId == resource.data.requestId
            );
          allow delete:
            if isRealOwner();
        }

        match /screenshots/{docId} {
          allow read:
            if isRealOwner();
          allow create:
            if isThisChildsOwnSession();
          allow update, delete:
            if isRealOwner();
        }

        match /screenshot_data/{docId} {
          allow read:
            if isRealOwner();
          allow create:
            if isThisChildsOwnSession();
          allow update, delete:
            if isRealOwner();
        }

        match /mic_requests/{docId} {
          allow read:
            if isRealOwner() || isThisChildsOwnSession();
          allow create, update:
            if isRealOwner() || isThisChildsOwnSession();
          allow delete:
            if isRealOwner();
        }

        match /mic_audio/{docId} {
          allow create:
            if isThisChildsOwnSession();
          allow read:
            if isRealOwner();
          allow delete:
            if isRealOwner();
          allow update:
            if false;
        }

        match /voice_recordings/{docId} {
          allow create:
            if isThisChildsOwnSession();
          allow read:
            if isRealOwner();
          allow delete:
            if isRealOwner();
          allow update:
            if false;
        }

        match /{subcollection}/{docId} {
          allow read, write:
            if (isRealOwner() || isThisChildsOwnSession())
              && subcollection != 'screenshot_settings'
              && subcollection != 'screenshot_trigger_state'
              && subcollection != 'screenshot_requests'
              && subcollection != 'screenshots'
              && subcollection != 'screenshot_data'
              && subcollection != 'mic_requests'
              && subcollection != 'mic_audio'
              && subcollection != 'voice_recordings';
        }
      }
    }

    match /parents/{uid} {
      allow read:
        if isRealUser() &&
        (request.auth.uid == uid || isAdmin());
      allow write:
        if isRealUser() &&
        (request.auth.uid == uid || isAdmin());
    }

    match /support_messages/{msgId} {
      allow create:
        if isRealUser() &&
        request.resource.data.fromUid == request.auth.uid;
      allow read:
        if isRealUser() &&
        (
          resource.data.fromUid == request.auth.uid ||
          isAdmin()
        );
      allow update:
        if isAdmin();
    }

    match /premium_requests/{reqId} {
      allow create:
        if isRealUser() &&
        request.resource.data.fromUid == request.auth.uid;
      allow read:
        if isRealUser() &&
        (
          resource.data.fromUid == request.auth.uid ||
          isAdmin()
        );
      allow update:
        if isAdmin();
    }

    match /admin_cards/{cardId} {
      allow read:
        if isRealUser();
      allow write:
        if isAdmin();
    }
  }
}
